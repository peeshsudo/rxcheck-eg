# ============================================================
# RxCheck EG — Environment template
# Copy to .env and replace every CHANGE_ME value.
# The app refuses to start if placeholders are still present.
# ============================================================

# ==== Environment ====
ENVIRONMENT=development          # development | production
DEBUG=true                       # must be false in production

# ==== Database ====
POSTGRES_USER=rxcheck
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rxcheck
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rxcheck:CHANGE_ME_STRONG_PASSWORD@db:5432/rxcheck

# ==== Backend ====
BACKEND_PORT=8000
BACKEND_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS
BACKEND_ADMIN_KEY=CHANGE_ME_ADMIN_API_KEY
BACKEND_CORS_ORIGINS=http://localhost:3000

# ==== Frontend ====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ==== External APIs ====
OPENFDA_API_KEY=                 # optional, higher rate limits
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# EMA publishes machine-readable JSON at these two fixed URLs:
EMA_MEDICINES_JSON_URL=https://www.ema.europa.eu/en/media/67423
EMA_DOCUMENTS_JSON_URL=https://www.ema.europa.eu/en/media/67425

# EDA — no public API exists. See docs/data-sources.md
EDA_PORTAL_URL=https://eservices.edaegypt.gov.eg/EDASearch/SearchRegDrugs.aspx

# ==== OCR ====
OCR_PROVIDER=tesseract           # tesseract | google | aws
GOOGLE_VISION_KEY=

# ==== AI Agent ====
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
VECTOR_DB_URL=http://chromadb:8000

# ==== Scheduling ====
SYNC_FDA_CRON=0 2 * * *
SYNC_EMA_CRON=0 3 * * *
SYNC_EDA_CRON=0 4 * * *